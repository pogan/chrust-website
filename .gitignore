# macOS / editor cruft
.DS_Store

# Dependencies
node_modules/

# Design sources. These live inside public/ but must never be served — see the
# extension blocklist in chrust-website-express-app.js, which 404s them.
*.psd
*.ai
*.xcf
*.aep
*.prproj

# Video. public/video/ holds both the multi-hundred-MB masters and the ~150 MB
# H.264 re-encodes the site actually serves. Neither belongs in git: committing
# them once put 1.29 GB of blobs into the history, and GitHub hard-rejects any
# file over 100 MB. Deploy the *_720.mp4 / *_web.mp4 files with scp or rsync.
public/video/

# Generated by the Sass toolchain. public/main.css is deliberately NOT ignored —
# it is the file index.html loads, and it is committed.
public/main.css.map
css/
