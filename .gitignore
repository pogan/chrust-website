# macOS / editor cruft
.DS_Store

# Dependencies
node_modules/

# Environment / secrets. The /anatema preorder checkout reads Stripe keys from
# .env (see anatema.js); .env.example documents the shape.
.env
.env.*
!.env.example

# Runtime order log written by the /anatema Stripe webhook. Holds buyers'
# names, e-mails, phone numbers and shipping addresses — never commit it.
/data/

# Raw briefing material for the ANATEMA! landing page (internal PDF, unedited
# stock photos, lyric drafts). Web-ready copies live in public/img/anatema/.
/_anatema_input_data/

# Design sources. These live inside public/ but must never be served — see the
# extension blocklist in chrust-website-express-app.js, which 404s them.
*.psd
*.ai
*.xcf
*.aep
*.prproj

# Video. The ~141 MB of H.264 re-encodes the site serves ARE committed, so a
# `git pull` deploys them. Everything else in public/video/ is not: the masters
# run to 883 MB each, and GitHub hard-rejects any file over 100 MB. Committing
# masters once already put 1.29 GB of blobs into this history.
#
# The deny-then-allow shape below is deliberate: drop a master into
# public/video/ and it stays ignored, so `git add -A` cannot swallow it again.
public/video/*
!public/video/chrust_*_720.mp4
!public/video/chrust_*_web.mp4

# Generated by the Sass toolchain. public/main.css is deliberately NOT ignored —
# it is the file index.html loads, and it is committed.
public/main.css.map
css/
