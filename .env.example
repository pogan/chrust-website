# Copy to .env and fill in. Only /anatema (anatema.js) and /anatema/orders
# (anatema-orders.js) read this file. The rest of the site is a plain static
# server and needs nothing here. Without STRIPE_SECRET_KEY the /anatema pages
# still render — only the "Zamawiam" button returns 503. Without
# GOOGLE_CLIENT_ID/SESSION_SECRET, /anatema/orders still renders a login
# screen — it just can't complete a login.

# Port / environment for the Express app (optional; defaults 3000 / development).
PORT=3000
NODE_ENV=development

# --- Stripe ---
# Secret key. Local development: sk_test_...  Production: sk_live_...
STRIPE_SECRET_KEY=
# Publishable key — not used server-side today, kept for parity / future use.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for POST /anatema/webhook.
#   Local:      `stripe listen --forward-to localhost:3000/anatema/webhook` prints whsec_...
#   Production: Stripe Dashboard -> Developers -> Webhooks -> endpoint /anatema/webhook
STRIPE_WEBHOOK_SECRET=

# Absolute site URL — Stripe returns here after checkout (success/cancel URLs).
# Production: https://chrustfolkmusic.pl
PUBLIC_BASE_URL=http://localhost:3000

# Optional: a ready VAT TaxRate id (txr_...). Leave EMPTY — anatema.js creates an
# inclusive 23% PL rate on first use and reuses it. Do NOT paste the bdik rate:
# that one is inclusive:false and would double-count VAT here.
STRIPE_TAX_RATE_ID=

# --- /anatema/orders (Google-login order list) ---
# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application). Add both
# http://localhost:3000 and https://chrustfolkmusic.pl as "Authorized JavaScript
# origins" — no redirect URI needed, this uses the Google Identity Services
# button flow (an ID token posted straight to the server), not the redirect
# flow, so no client secret is needed either.
GOOGLE_CLIENT_ID=
# Comma-separated e-mail addresses allowed to view /anatema/orders. Checked on
# every request, not just at login.
ANATEMA_ADMIN_EMAILS=karol.konop@gmail.com,malgorzata.oleszczuk7@gmail.com
# Random secret that signs the /anatema/orders session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
